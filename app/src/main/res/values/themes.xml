<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PixelAppLock" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FFFFFFFF</item>
    </style>

    <style name="Theme.PixelAppLock.LockOverlay" parent="Theme.PixelAppLock">
        <item name="android:windowBackground">#FF0F141A</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
